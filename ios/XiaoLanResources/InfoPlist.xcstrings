      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小藍 talks to its boards over Bluetooth to see the screen, move the pointer and send voice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小藍通過藍牙連接開發板，用來看畫面、移動指標和發送語音。"
