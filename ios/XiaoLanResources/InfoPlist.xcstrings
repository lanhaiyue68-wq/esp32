    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小藍 receives the board's mirrored screen and connects to your order servers on the local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小藍從開發板接收鏡像畫面，並連接你電腦或伺服器上的指令服務。"
